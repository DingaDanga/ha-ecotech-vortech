          "name": "Pump",
          "description": "The pump."
        },
        "scene": {
          "name": "Scene",
          "description": "Scene name as shown in the Mobius app, or its number."
        },
        "minutes": {
          "name": "Minutes",
          "description": "How long it runs. Leave empty for the scene's own time."
        }
      }
    },
    "resume_schedule": {
      "name": "Back to schedule",
      "description": "Ends any running scene so the pump follows its schedule.",
      "fields": {
        "device_id": {
          "name": "Pump",
          "description": "The pump."
        }
      }
    },
    "get_schedule": {
      "name": "Get schedule",
      "description": "Returns the pump's schedule (each block's start time, wave mode and settings).",
      "fields": {
        "device_id": {
          "name": "Pump",
          "description": "The pump."
        }
      }
    },
    "set_schedule": {
      "name": "Set schedule",
      "description": "Writes a whole schedule, in the same form Get schedule returns.",
      "fields": {
        "device_id": {
          "name": "Pump",
          "description": "The pump."
        },
        "schedule": {
          "name": "Schedule",
          "description": "List of blocks: time_minutes, flags, mode and params."
        }
      }
    },
    "set_wave": {
      "name": "Set wave",
      "description": "Sets the wave mode, speed and timing of the schedule block running now.",
      "fields": {
        "device_id": {
          "name": "Pump",
          "description": "The pump."
        },
        "mode": {
          "name": "Wave mode",
          "description": "Wave mode."
        },
        "speed": {
          "name": "Speed",
          "description": "Top speed in percent."
        },
