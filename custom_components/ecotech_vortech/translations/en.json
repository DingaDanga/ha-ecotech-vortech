{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Choose your pump",
        "description": "Pumps Home Assistant can hear over Bluetooth (directly or through an ESPHome Bluetooth proxy).",
        "data": {
          "address": "Pump"
        }
      },
      "confirm": {
        "title": "Add {name}?",
        "description": "Home Assistant will connect to the pump itself at {address} (signal {rssi} dBm).\n\nThe pump takes one Bluetooth connection at a time: close the Mobius app first, and remove any other integration that connects to this pump."
      }
    },
    "abort": {
      "already_configured": "This pump is already set up.",
      "no_devices_found": "No EcoTech Mobius pump is being heard over Bluetooth. Check the pump is powered, the Mobius app is closed and a Bluetooth proxy is near the tank.",
      "no_serial": "The pump's advertisement didn't include its serial number. Turn on active scanning on the Bluetooth proxy and try again.",
      "cannot_connect": "Couldn't connect to the pump to read its serial number. Close the Mobius app, make sure no other integration is connected to the pump, and try again.",
      "not_supported": "This isn't an EcoTech Mobius device."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Pump settings",
        "data": {
          "poll_interval": "Read the pump every",
          "keep_connected": "Keep the Bluetooth connection open",
          "off_hold_minutes": "Pump switch off: back on by itself after",
          "app_release_minutes": "'Hand over to Mobius app' lasts",
          "tank_volume": "Tank volume (for the turnover reading, 0 = off)",
          "time_sync": "Keep the pump's clock and time zone right",
          "firmware_check": "Check EcoTech for new firmware"
        },
        "data_description": {
          "keep_connected": "Faster controls. Turn off to connect only for each reading, which leaves gaps for the Mobius app.",
          "off_hold_minutes": "A safety net so the pump can't be left off. Most is 1092 minutes (just over 18 hours).",
          "time_sync": "Schedules run on the pump's own clock. Checked every 6 hours and corrected if it is out by more than 30 seconds."
        }
      }
    }
  },
